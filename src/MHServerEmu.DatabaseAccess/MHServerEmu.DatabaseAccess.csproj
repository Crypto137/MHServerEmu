<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Platforms>x64</Platforms>
    <Configurations>Debug;Release;Debug 1.48;Release 1.48;Debug 1.53;Release 1.53</Configurations>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <InformationalVersion>$(AssemblyVersion)</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DefineConstants>$(DefineConstants);GAME_VERSION_1_52</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DefineConstants>$(DefineConstants);GAME_VERSION_1_52</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug 1.48|x64'">
    <DefineConstants>$(DefineConstants);DEBUG;GAME_VERSION_1_48</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release 1.48|x64'">
    <DefineConstants>$(DefineConstants);RELEASE;GAME_VERSION_1_48</DefineConstants>
  </PropertyGroup>
	
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug 1.53|x64'">
    <DefineConstants>$(DefineConstants);DEBUG;GAME_VERSION_1_53</DefineConstants>
  </PropertyGroup>
	
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release 1.53|x64'">
    <DefineConstants>$(DefineConstants);RELEASE;GAME_VERSION_1_53</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="SQLite\Scripts\InitializeDatabase.sql" />
    <None Remove="SQLite\Scripts\InitializeLeaderboardsDatabase.sql" />
    <None Remove="SQLite\Scripts\Migrations\0.sql" />
    <None Remove="SQLite\Scripts\Migrations\1.sql" />
    <None Remove="SQLite\Scripts\Migrations\2.sql" />
    <None Remove="SQLite\Scripts\Migrations\3.sql" />
    <None Remove="SQLite\Scripts\Migrations\4.sql" />
    <None Remove="SQLite\Scripts\Migrations\5.sql" />
    <None Remove="SQLite\Scripts\Migrations\6.sql" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SQLite\Scripts\InitializeDatabase.sql" />
    <EmbeddedResource Include="SQLite\Scripts\InitializeLeaderboardsDatabase.sql" />
    <EmbeddedResource Include="SQLite\Scripts\Migrations\0.sql" />
    <EmbeddedResource Include="SQLite\Scripts\Migrations\1.sql" />
    <EmbeddedResource Include="SQLite\Scripts\Migrations\2.sql" />
    <EmbeddedResource Include="SQLite\Scripts\Migrations\3.sql" />
    <EmbeddedResource Include="SQLite\Scripts\Migrations\4.sql" />
    <EmbeddedResource Include="SQLite\Scripts\Migrations\5.sql" />
    <EmbeddedResource Include="SQLite\Scripts\Migrations\6.sql" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\MHServerEmu.Core\MHServerEmu.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Dapper">
      <HintPath>..\..\dep\Dapper\Dapper.dll</HintPath>
    </Reference>
    <Reference Include="System.Data.SQLite">
      <HintPath>..\..\dep\System.Data.SQLite\System.Data.SQLite.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Content Include="Interop\win-x64\SQLite.Interop.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>SQLite.Interop.dll</TargetPath>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Content Include="Interop\linux-x64\SQLite.Interop.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>SQLite.Interop.dll</TargetPath>
    </Content>
  </ItemGroup>

</Project>
