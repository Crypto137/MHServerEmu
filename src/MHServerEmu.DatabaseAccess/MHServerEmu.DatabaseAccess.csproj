<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Configurations>Debug;Release;Debug 1.48;Release 1.48;Debug 1.53;Release 1.53;Debug PS4;Release PS4</Configurations>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <InformationalVersion>$(AssemblyVersion)</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>$(DefineConstants);GAME_VERSION_1_52;PLATFORM_TYPE_PC</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>$(DefineConstants);GAME_VERSION_1_52;PLATFORM_TYPE_PC</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug 1.48'">
    <DefineConstants>$(DefineConstants);DEBUG;GAME_VERSION_1_48;PLATFORM_TYPE_PC</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release 1.48'">
    <DefineConstants>$(DefineConstants);RELEASE;GAME_VERSION_1_48;PLATFORM_TYPE_PC</DefineConstants>
  </PropertyGroup>
	
  <PropertyGroup Condition="'$(Configuration)'=='Debug 1.53'">
    <DefineConstants>$(DefineConstants);DEBUG;GAME_VERSION_1_53;PLATFORM_TYPE_PC</DefineConstants>
  </PropertyGroup>
	
  <PropertyGroup Condition="'$(Configuration))'=='Release 1.53'">
    <DefineConstants>$(DefineConstants);RELEASE;GAME_VERSION_1_53;PLATFORM_TYPE_PC</DefineConstants>
  </PropertyGroup>
	
  <PropertyGroup Condition="'$(Configuration)'=='Debug PS4'">
    <DefineConstants>$(DefineConstants);DEBUG;GAME_VERSION_1_53;PLATFORM_TYPE_PS4</DefineConstants>
  </PropertyGroup>
	
  <PropertyGroup Condition="'$(Configuration)'=='Release PS4'">
    <DefineConstants>$(DefineConstants);RELEASE;GAME_VERSION_1_53;PLATFORM_TYPE_PS4</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="SQLite\Scripts\InitializeDatabase.sql" />
    <None Remove="SQLite\Scripts\InitializeLeaderboardsDatabase.sql" />
    <None Remove="SQLite\Scripts\Migrations\0.sql" />
    <None Remove="SQLite\Scripts\Migrations\1.sql" />
    <None Remove="SQLite\Scripts\Migrations\2.sql" />
    <None Remove="SQLite\Scripts\Migrations\3.sql" />
    <None Remove="SQLite\Scripts\Migrations\4.sql" />
    <None Remove="SQLite\Scripts\Migrations\5.sql" />
    <None Remove="SQLite\Scripts\Migrations\6.sql" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SQLite\Scripts\InitializeDatabase.sql" />
    <EmbeddedResource Include="SQLite\Scripts\InitializeLeaderboardsDatabase.sql" />
    <EmbeddedResource Include="SQLite\Scripts\Migrations\0.sql" />
    <EmbeddedResource Include="SQLite\Scripts\Migrations\1.sql" />
    <EmbeddedResource Include="SQLite\Scripts\Migrations\2.sql" />
    <EmbeddedResource Include="SQLite\Scripts\Migrations\3.sql" />
    <EmbeddedResource Include="SQLite\Scripts\Migrations\4.sql" />
    <EmbeddedResource Include="SQLite\Scripts\Migrations\5.sql" />
    <EmbeddedResource Include="SQLite\Scripts\Migrations\6.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\MHServerEmu.Core\MHServerEmu.Core.csproj" />
  </ItemGroup>

</Project>
